# For `docker run --env-file demo/.env ...`. Railway sets these as service variables. Never commit real values.

# Admin backend user; the e-mail is also the username. Required on first boot.
# Password policy: 8+ characters with upper- and lower-case letter, number and special character.
DEMO_ADMIN_EMAIL=you@example.com
DEMO_ADMIN_PASSWORD=Change-me1!

# Optional second account (admin without maintainer rights), e.g. for automated tests
# DEMO_EDITOR_EMAIL=editor@example.com
# DEMO_EDITOR_PASSWORD=Change-me2!

# Supertext API key. No account yet? Create one at https://www.supertext.com/person/en/account/signin
# Generate the key at https://www.supertext.com/en/integrations/api (supertext.com > Integrations > API, requires the Admin role).
SUPERTEXT_API_KEY=
# SUPERTEXT_API_ENDPOINT=https://api.staging.supertext.com/v1/
# TYPO3_TRUSTED_HOSTS=^(localhost|127\.0\.0\.1)$
